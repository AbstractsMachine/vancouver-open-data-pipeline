# Google Cloud project that holds the BigQuery datasets (you need BigQuery
# Data Editor + Job User on it). Authentication: `gcloud auth application-default login`
# or GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account key.
GCP_PROJECT=your-gcp-project
# where the raw tables are loaded
VAN_RAW_DATASET=vancouver_raw
# dbt writes <DBT_SCHEMA>_staging, _analytics, _marts, _seeds
DBT_SCHEMA=vancouver
BQ_LOCATION=EU
